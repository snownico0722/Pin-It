// The PinIt window: a compact list of pinned windows with opacity sliders,
// plus four sheets (window picker, shortcut editor, settings, about).

import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import {
    Glyph, Button, ButtonKind, IconButton, CheckBox, Slider, KeyCombo, Card, SectionTitle, AppAvatar, AppMark, Sheet
} from "controls.slint";

export { Theme }

export struct PinRow {
    title: string,
    process: string,
    opacity: int,
    click-through: bool,
    icon: image,
    has-icon: bool,
    initial: string,
    tint: color,
    waiting: bool,   // a saved pin whose window isn't open yet
}

export struct PickItem {
    title: string,
    process: string,
    icon: image,
    has-icon: bool,
    initial: string,
    tint: color,
    pinned: bool,
}

export struct ShortcutEdit {
    label: string,
    win: bool,
    ctrl: bool,
    alt: bool,
    shift: bool,
    key-index: int,
    unavailable: bool,   // Windows refused it: another app owns these keys
}

component PinCard {
    in property <PinRow> pin;
    callback opacity-changed(int);
    callback toggle-click-through();
    callback unpin();
    callback hovered(bool);

    property <bool> hover: touch.has-hover;
    changed hover => { root.hovered(hover); }

    height: 44px;
    // Fade in when the row first appears.
    property <bool> shown: false;
    init => { shown = true; }
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.medium; easing: ease-out; }

    touch := TouchArea { }

    Card {
        hover-lift: !pin.waiting;
        hovered: hover;
        background: pin.waiting ? Theme.window : (hover ? Theme.card-hover : Theme.card);
        border-color: pin.waiting ? Theme.border : Theme.card-border;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 5px;
            spacing: 7px;

            AppAvatar {
                y: (parent.height - self.height) / 2;
                icon: pin.icon;
                has-icon: pin.has-icon;
                initial: pin.initial;
                tint: pin.tint;
                opacity: pin.waiting ? 0.55 : 1;
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 50px;
                Text {
                    text: pin.title;
                    overflow: elide;
                    font-size: Theme.body;
                    font-weight: 600;
                    color: pin.waiting ? Theme.text-muted : Theme.text;
                }
                Text {
                    text: pin.waiting ? @tr("ui" => "Waiting for {}", pin.process) : pin.process;
                    overflow: elide;
                    font-size: Theme.tiny;
                    color: Theme.text-muted;
                }
            }

            if !pin.waiting: Slider {
                y: (parent.height - self.height) / 2;
                width: 60px;
                value: pin.opacity;
                minimum: 20;
                maximum: 100;
                label: @tr("ui" => "Opacity of {}", pin.title);
                changed(v) => { root.opacity-changed(v); }
            }
            if !pin.waiting: Text {
                text: pin.opacity + "%";
                width: 27px;
                vertical-alignment: center;
                horizontal-alignment: right;
                font-size: Theme.tiny;
                color: Theme.text-muted;
            }
            if !pin.waiting: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: 6px;
                background: pin.click-through ? Theme.accent-soft : transparent;
                IconButton {
                    icon: Icons.pointer;
                    tooltip: pin.click-through ? @tr("ui" => "Clicks pass through (on)") : @tr("ui" => "Clicks pass through (off)");
                    accessible-role: checkbox;
                    accessible-checkable: true;
                    accessible-checked: pin.click-through;
                    clicked => { root.toggle-click-through(); }
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.close;
                kind: danger-ghost;
                tooltip: pin.waiting ? @tr("ui" => "Forget {}", pin.title) : @tr("ui" => "Unpin {}", pin.title);
                clicked => { root.unpin(); }
            }
        }
    }
}

component PickRow {
    in property <PickItem> item;
    callback picked();

    height: 38px;
    accessible-role: button;
    accessible-label: item.pinned ? @tr("ui" => "Unpin {} ({})", item.title, item.process) : @tr("ui" => "Pin {} ({})", item.title, item.process);
    accessible-action-default => { root.picked(); }

    Rectangle {
        border-radius: 7px;
        background: touch.has-hover ? Theme.raised : transparent;
        animate background { duration: Theme.fast; }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            AppAvatar {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                icon: item.icon;
                has-icon: item.has-icon;
                initial: item.initial;
                tint: item.tint;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: item.title;
                    overflow: elide;
                    font-size: Theme.body;
                    color: Theme.text;
                }
                Text {
                    text: item.process;
                    overflow: elide;
                    font-size: Theme.tiny;
                    color: Theme.text-muted;
                }
            }
            if item.pinned: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: badge.preferred-width;
                border-radius: 5px;
                background: Theme.accent-soft;
                badge := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 3px;
                    Glyph {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.pin;
                        size: 10px;
                        color: Theme.accent-hover;
                    }
                    Text {
                        text: @tr("ui" => "Pinned");
                        vertical-alignment: center;
                        font-size: Theme.tiny;
                        font-weight: 600;
                        color: Theme.accent-hover;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component ModifierChip {
    in property <string> text;
    in property <bool> on;
    callback toggled();
    width: 38px;
    height: 24px;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        border-radius: 6px;
        background: on ? Theme.accent-strong : touch.has-hover ? Theme.raised : Theme.card;
        border-width: on ? 0px : 1px;
        border-color: Theme.border;
        animate background { duration: Theme.fast; }
        Text {
            text: root.text;
            font-size: Theme.tiny;
            font-weight: 600;
            color: on ? Theme.on-accent : Theme.text-muted;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component AppWindow inherits Window {
    title: "PinIt";
    // Keep the operating system window, but render its chrome in Slint.
    // Keep the native resize hit-test around the visible card, not merely
    // at the outer edge of the 16px transparent shadow margin.
    no-frame: true;
    resize-border-width: 20px;
    icon: @image-url("../../resources/icon-256.png");
    background: transparent;
    default-font-family: Theme.font;
    default-font-size: Theme.body;
    // 16px transparent breathing room on each side for the real soft shadow.
    // The inner panel keeps the previous 340px content width.
    preferred-width: 372px;
    min-width: 372px;
    max-width: 372px;
    preferred-height: 382px;
    min-height: 292px;

    // State from Rust
    in property <[PinRow]> pins;
    in property <[string]> pin-keys;           // the pin shortcut, for the hint line
    in-out property <bool> sound;
    in-out property <bool> notifications;
    in-out property <bool> autostart;
    in-out property <int> language-index: 0;
    in property <string> version;
    in property <bool> animations <=> Theme.animations;
    out property <bool> dark: Theme.dark;
    out property <color> window-color: Theme.window;
    callback theme-changed();
    changed dark => { root.theme-changed(); }

    in property <[PickItem]> pick-items;
    in-out property <string> pick-filter;
    in-out property <bool> picker-open;

    in property <[ShortcutEdit]> shortcut-edits;
    in property <[string]> key-labels;
    in-out property <string> shortcut-error;
    in-out property <bool> shortcuts-open;

    in-out property <bool> settings-open;

    // Toast
    in-out property <string> toast-text;
    in-out property <bool> toast-visible;

    // Callbacks to Rust
    callback open-picker();
    callback start-pin-drag();
    in property <bool> pin-drag-active: false;
    callback pick(int);
    callback filter-changed(string);
    callback set-opacity(int, int);
    callback toggle-click-through(int);
    callback unpin(int);
    callback row-hovered(int, bool);
    callback unpin-all();
    callback setting-changed(string, bool);
    callback language-changed(int);
    callback open-shortcuts();
    callback shortcut-chip(int, string);
    callback shortcut-key(int, int);
    callback save-shortcuts();
    callback restore-default-shortcuts();
    callback open-url(string);

    public function focus-search() {
        search.focus();
    }

    // Slint's software renderer anti-aliases rounded Rectangles, but
    // nearest-samples the RGBA nine-slice image across DPI scales.
    // Keep the nine-slice for the soft *shadow only*. The actual rounded
    // card and hairline border are native vector geometry below.
    Image {
        source: Theme.dark
            ? @image-url("../../resources/ui-shell-dark.png", nine-slice(40))
            : @image-url("../../resources/ui-shell-light.png", nine-slice(40));
        width: parent.width;
        height: parent.height;
        image-fit: fill;
    }
    Rectangle {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        // The raster asset behind this Rectangle is shadow-only; draw the
        // visible corners and subtle border through Slint's native
        // anti-aliased rounded-rectangle path at the current monitor DPI.
        background: Theme.window;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.window-outline;

        // The entire top band inside the native 20px resize border is a
        // window-move target, including the margin above the title and the
        // gaps between controls. Place it BEHIND the interactive buttons:
        // their TouchAreas still receive clicks and the pin has its own
        // cross-window drag gesture. The last 8px before the primary action
        // belong to the title band too, never to the content button.
        WindowMoveArea {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: 44px;
            enabled: !root.pin-drag-active && !root.picker-open
                && !root.shortcuts-open && !root.settings-open;
        }

        VerticalLayout {
            padding: 12px;
            padding-top: 10px;
            spacing: 8px;

        // All header spacing, branding and non-button pixels can start a
        // native move. Buttons stay clickable; the pin stays draggable.
        HorizontalLayout {
            height: 30px;
            spacing: 3px;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                AppMark {
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "PinIt";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-family: Theme.display-font;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                    accessible-role: text;
                }
            }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: root.pin-drag-active ? Theme.accent-soft
                    : drag-pin-touch.has-hover ? Theme.raised : transparent;
                accessible-role: button;
                accessible-label: @tr("ui" => "Drag to pin a window");
                Glyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pin;
                    size: 17px;
                    color: root.pin-drag-active ? Theme.accent-hover : Theme.text-muted;
                }
                drag-pin-touch := TouchArea {
                    mouse-cursor: root.pin-drag-active ? crosshair : grab;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start-pin-drag();
                        }
                    }
                }
            }
            IconButton {
                width: 28px;
                height: 28px;
                icon-size: 17px;
                icon: Icons.keyboard;
                tooltip: @tr("ui" => "Shortcuts");
                clicked => { root.open-shortcuts(); }
            }
            IconButton {
                width: 28px;
                height: 28px;
                icon-size: 16px;
                icon: Icons.settings;
                tooltip: @tr("ui" => "Settings");
                clicked => { root.settings-open = true; }
            }
            IconButton {
                width: 28px;
                height: 28px;
                icon-size: 16px;
                icon: Icons.minus;
                tooltip: @tr("ui" => "Minimize");
                clicked => { root.minimized = true; }
            }
            IconButton {
                width: 28px;
                height: 28px;
                icon-size: 16px;
                icon: Icons.close;
                kind: danger-ghost;
                tooltip: @tr("ui" => "Close");
                // Uses the existing close-requested -> hide-to-tray logic.
                clicked => { root.close(); }
            }
        }

        Button {
            kind: primary;
            icon: Icons.plus;
            text: @tr("ui" => "Pin a window…");
            font-size: Theme.body;
            height: 30px;
            horizontal-stretch: 1;
            clicked => { root.open-picker(); }
        }

        // Pinned windows
        HorizontalLayout {
            height: 18px;
            SectionTitle {
                text: pins.length == 0 ? @tr("ui" => "PINNED") : @tr("ui" => "PINNED · {}", pins.length);
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if pins.length > 0: Button {
                kind: ghost;
                text: @tr("ui" => "Unpin all");
                font-size: Theme.tiny;
                height: 18px;
                radius: 5px;
                clicked => { root.unpin-all(); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            min-height: 96px;

            VerticalLayout {
                spacing: 5px;
                padding-bottom: 3px;
                padding-left: 1px;
                padding-right: 1px;
                alignment: start;

                if pins.length == 0: Rectangle {
                    height: 92px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: Theme.accent-soft;
                                Glyph {
                                    icon: Icons.pin;
                                    size: 15px;
                                    color: Theme.accent-hover;
                                }
                            }
                        }
                        Text {
                            text: @tr("ui" => "Nothing pinned yet");
                            horizontal-alignment: center;
                            font-size: Theme.body;
                            font-weight: 600;
                            color: Theme.text;
                        }
                    }
                }

                for p[i] in pins: PinCard {
                    pin: p;
                    opacity-changed(v) => { root.set-opacity(i, v); }
                    toggle-click-through => { root.toggle-click-through(i); }
                    unpin => { root.unpin(i); }
                    hovered(h) => { root.row-hovered(i, h); }
                }
            }
        }

        // How to pin without opening PinIt
        HorizontalLayout {
            alignment: center;
            spacing: 5px;
            Text {
                text: @tr("ui" => "Pin the window you're in:");
                vertical-alignment: center;
                font-size: Theme.tiny;
                color: Theme.text-muted;
            }
            KeyCombo { keys: pin-keys; }
        }
    }

    // Toast
    toast := Rectangle {
        property <bool> show: root.toast-visible && root.toast-text != "";
        x: (parent.width - self.width) / 2;
        y: show ? parent.height - self.height - 40px : parent.height - self.height - 28px;
        opacity: show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate y, opacity { duration: Theme.medium; easing: ease-out; }
        width: min(parent.width - 32px, toast-label.preferred-width + 22px);
        height: toast-label.preferred-height + 12px;
        border-radius: 8px;
        background: Theme.toast-bg;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000040;
        toast-label := Text {
            width: parent.width - 22px;
            text: root.toast-text;
            wrap: word-wrap;
            horizontal-alignment: center;
            font-size: Theme.small;
            font-weight: 500;
            color: Theme.toast-text;
            accessible-role: text;
        }
        Timer {
            interval: 3200ms;
            running: toast.show;
            triggered => { root.toast-visible = false; }
        }
    }

    // Window picker
    Sheet {
        open: root.picker-open;
        title: @tr("ui" => "Pin a window");
        sheet-height: 420px;
        close => { root.picker-open = false; }

        search := LineEdit {
            placeholder-text: @tr("ui" => "Search windows");
            font-size: Theme.body;
            text <=> root.pick-filter;
            edited(t) => { root.filter-changed(t); }
            accepted => {
                if (root.pick-items.length > 0) {
                    root.pick(0);
                }
            }
        }

        if pick-items.length == 0: VerticalLayout {
            alignment: center;
            vertical-stretch: 1;
            Text {
                text: root.pick-filter == "" ? @tr("ui" => "No windows to pin. Open an app and try again.") : @tr("ui" => "No window matches “{}”.", root.pick-filter);
                horizontal-alignment: center;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
        }

        if pick-items.length > 0: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                for item[i] in pick-items: PickRow {
                    item: item;
                    picked => { root.pick(i); }
                }
            }
        }
    }

    // Shortcut editor
    Sheet {
        open: root.shortcuts-open;
        title: @tr("ui" => "Shortcuts");
        subtitle: @tr("ui" => "Each needs Win, Ctrl or Alt.");
        sheet-height: 420px;
        close => { root.shortcuts-open = false; }

        editor-scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                // Fit the sheet's width; only scroll vertically.
                width: editor-scroll.visible-width - 10px;
                spacing: 9px;
                alignment: start;
                for edit[i] in shortcut-edits: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: edit.label;
                            font-size: Theme.small;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        if edit.unavailable: Text {
                            text: @tr("ui" => "· in use by another app");
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Theme.tiny;
                            color: Theme.danger;
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        ModifierChip { y: (parent.height - self.height) / 2; text: "Win"; on: edit.win; toggled => { root.shortcut-chip(i, "win"); } }
                        ModifierChip { y: (parent.height - self.height) / 2; text: "Ctrl"; on: edit.ctrl; toggled => { root.shortcut-chip(i, "ctrl"); } }
                        ModifierChip { y: (parent.height - self.height) / 2; text: "Alt"; on: edit.alt; toggled => { root.shortcut-chip(i, "alt"); } }
                        ModifierChip { y: (parent.height - self.height) / 2; text: "Shift"; on: edit.shift; toggled => { root.shortcut-chip(i, "shift"); } }
                        ComboBox {
                            horizontal-stretch: 1;
                            min-width: 70px;
                            model: root.key-labels;
                            current-index: edit.key-index;
                            selected => { root.shortcut-key(i, self.current-index); }
                        }
                    }
                }
            }
        }

        if shortcut-error != "": Text {
            text: shortcut-error;
            wrap: word-wrap;
            font-size: Theme.small;
            color: Theme.danger;
            accessible-role: text;
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                kind: ghost;
                text: @tr("ui" => "Defaults");
                clicked => { root.restore-default-shortcuts(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("ui" => "Cancel");
                clicked => { root.shortcuts-open = false; }
            }
            Button {
                kind: primary;
                text: @tr("ui" => "Save");
                clicked => { root.save-shortcuts(); }
            }
        }
    }

    // Settings
    Sheet {
        open: root.settings-open;
        title: @tr("ui" => "Settings");
        sheet-height: 245px;
        close => { root.settings-open = false; }

        VerticalLayout {
            spacing: 0px;
            CheckBox {
                text: @tr("ui" => "Play a sound when pinning");
                checked <=> root.sound;
                toggled(on) => { root.setting-changed("sound", on); }
            }
            CheckBox {
                text: @tr("ui" => "Show a notification when pinning");
                checked <=> root.notifications;
                toggled(on) => { root.setting-changed("notifications", on); }
            }
            CheckBox {
                text: @tr("ui" => "Start PinIt with Windows");
                checked <=> root.autostart;
                toggled(on) => { root.setting-changed("autostart", on); }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("ui" => "Language");
                    vertical-alignment: center;
                    color: Theme.text;
                    font-size: Theme.small;
                }
                ComboBox {
                    horizontal-stretch: 1;
                    model: [@tr("ui" => "Follow system"), "English", "简体中文"];
                    current-index <=> root.language-index;
                    selected(value) => { root.language-changed(self.current-index); }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Button {
                kind: ghost;
                icon: Icons.github;
                icon-size: 15px;
                text: "PinIt " + root.version;
                tooltip: "github.com/snownico0722";
                clicked => { root.open-url("https://github.com/snownico0722"); }
            }
        }
    }

    }
}
